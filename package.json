{
  "name": "smartnote",
  "version": "1.0.0",
  "description": "A simple local vault notetaking app built with Electron.",
  "license": "ISC",
  "author": "tdnguyen04",
  "type": "commonjs",
  "main": "out/main/index.js",
  "scripts": {
    "start": "electron-vite dev",
    "build": "electron-vite build",
    "dist": "electron-vite build && electron-builder --win",
    "dist:linux": "electron-vite build && electron-builder --linux",
    "pack": "electron-vite build && electron-builder --dir",
    "check": "tsc --noEmit && eslint . && vitest run"
  },
  "build": {
    "appId": "com.tdnguyen.smartnote",
    "productName": "Folio",
    "copyright": "Copyright © 2026",
    "files": [
      "out/**/*",
      "package.json"
    ],
    "directories": {
      "buildResources": "assets",
      "output": "dist"
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "category": "Office"
    },
    "win": {
      "target": [
        "nsis"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    }
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "electron": "^44.2.0",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "eslint": "^9.39.5",
    "eslint-plugin-import": "^2.32.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.1",
    "vite": "^7.3.7",
    "vitest": "^5.0.4"
  }
}
